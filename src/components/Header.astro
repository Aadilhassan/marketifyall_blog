---
import Logo from './Logo.astro'
import Nav from './Nav.astro'

const { current = '' } = Astro.props;
---

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 auto;
    max-width: 1400px;
    padding: 16px 24px;
    width: 100%;
    min-height: 64px;
  }

  /* Sticky, subtle divider and background for readability */
  :global(body) > .layout > header {
    position: sticky;
    top: 0;
    background: var(--background-body);
    border-bottom: 1px solid var(--border-color);
    z-index: 1001;
    backdrop-filter: saturate(120%) blur(2px);
  }

  @media (max-width: 768px) {
    header {
      padding: 12px 16px;
      min-height: 64px;
    }
  }
</style>

<header>
  <Logo />
  <Nav current={current} />
</header>
