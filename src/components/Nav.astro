---
// NavMenu.astro
import ToggleMenu from "./ToggleMenu.astro";
import ThemeToggleButton from "./ThemeToggleButton.svelte";
const { current = "" } = Astro.props;
---

<style>
  /* Ensure the modal/menu covers the full screen in dark mode */
  .menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--overlay-bg, #000); /* dark background */
    color: #fff;
    z-index: 9999;
  }

  /* Remove unwanted white background from child elements */
  .menu-overlay * {
    background-color: transparent !important;
  }

  nav {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: flex-end;
    transition: all 0.3s ease;
  }
  :root {
    --background-color: #ffffff;
  --menu-bg: #ffffff;
  --menu-text: #000000;
  }

  /* [data-theme="dark"] {
  --menu-bg: #121212;
  --menu-text: #ffffff;
} */

  a {
    text-decoration: none;
    margin-left: 20px;
    min-width: 70px;
    text-align: center;
    color: inherit;
  }

  .menu-toggle {
    display: none;
    font-size: 28px;
    cursor: pointer;
    background: none;
    border: none;
    margin-right: 1em;
    z-index: 1002;
  }

  @media screen and (max-width: 520px) {
    nav {
      flex-direction: column;
      position: absolute;
      top: 0;
      left: 0;
      background: var(--background-color, #fff);
      width: 100%;
      max-height: 0;
      padding: 0;
      overflow: hidden;
      opacity: 0;
      z-index: 1000;
    }

    /* Light mode */
    :root {
      --menu-bg: #ffffff;
      --menu-text: #000000;
    }

    /* Dark mode */
    html.dark {
      --background-color: #111827; /* Tailwind gray-900 */
  --menu-bg: #111827;
  --menu-text: #f9fafb;
    }

    nav.active {
      max-height: 500px;
      opacity: 1;
      padding: 60px 20px 20px;
    }
    #nav-menu.active {
      max-height: 500px;
      opacity: 1;
      padding: 60px 20px 20px;
      background-color: var(--menu-bg);
      color: var(--menu-text);
      transition:
        background-color 0.3s ease,
        color 0.3s ease;
    }

    .menu-toggle {
      display: block;
      position: relative;
    }

    nav a {
      margin: 10px 0;
    }
  }
</style>

<!-- Toggle Button -->
<button class="menu-toggle" id="menu-toggle">☰</button>

<!-- Nav Menu -->
<nav id="nav-menu">
  <a class={current === "" ? "selected" : ""} href="/">home</a>
  <a class={current === "about" ? "selected" : ""} href="/about">about</a>
  <a class={current === "blog" ? "selected" : ""} href="/blog">blog</a>
  <a class={current === "features" ? "selected" : ""} href="/features"
    >features</a
  >
  <a class={current === "docs" ? "selected" : ""} href="/docs">docs</a>
  <div class="theme-toggle-container">
    <ThemeToggleButton client:load />
    <ToggleMenu client:load />
  </div>
</nav>

