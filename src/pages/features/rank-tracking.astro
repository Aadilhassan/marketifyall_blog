---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Rank Tracking';
const description = 'Monitor keyword positions across regions and devices, and get recommendations to move up.';
const permalink = '/features/rank-tracking';
const heroImage = '/assets/images/ranktracking.webp';
---

<BaseLayout 
  title={`${title} — Marketifyall`}
  description={description}
  permalink={permalink}
  current="features"
  image={heroImage}
>
  <header class="feature-hero">
    <img src={heroImage} alt="Rank Tracking illustration" class="hero-image" loading="eager" />
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <hr />
  </header>

  <section class="container content">
    <h2>Competitor insights</h2>
    <p>See who you're competing with for each keyword and where you can win traffic most efficiently.</p>

    <h2>Prioritized actions</h2>
    <p>Get to-dos that have the biggest expected impact on rankings and visibility.</p>

    <h2>Advanced keyword research & analysis</h2>
    <p>
      Discover high-value keywords with comprehensive research tools. Analyze search volume, competition,
      and ranking difficulty to build an effective SEO strategy.
    </p>

    <h2>Local SEO & geographic tracking</h2>
    <p>
      Track rankings across different locations and optimize for local search. Monitor Google My Business
      performance and local pack rankings for location-based businesses.
    </p>

    <h2>Mobile & desktop tracking</h2>
    <p>
      Monitor rankings across different devices and screen sizes. Track mobile-first indexing performance
      and optimize for the growing mobile search market.
    </p>

    <h2>Automated reporting & alerts</h2>
    <p>
      Get notified of ranking changes, competitor movements, and opportunities. Generate comprehensive
      reports automatically and share insights with your team and clients.
    </p>
  </section>
</BaseLayout>

<style>
  .feature-hero { text-align: center; margin-top: 1rem; }
  .feature-hero h1 { margin: 0.5rem 0 0.25rem; }
  .feature-hero .lead { color: var(--text-secondary); font-family: var(--font-family-sans); font-weight: 500; max-width: 56ch; margin: 0 auto 0.75rem; }
  .feature-hero .hero-image { width: 100%; max-width: 560px; height: auto; display: block; margin: 1rem auto; border-radius: 10px; border: 1px solid var(--border-color); box-shadow: none; background: transparent; }

  /* Full-bleed banner variant */
  .feature-hero.banner .hero-image {
    max-width: none;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    border-radius: 0;
    border: none;
    height: 300px;
    object-fit: cover;
    object-position: center;
  }

  .feature-hero hr { min-width: 100px; width: 30%; }
  @media (max-width: 768px) { 
    .feature-hero .hero-image { max-width: 320px; } 
    .feature-hero.banner .hero-image {
      height: 200px;
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
    }
  }
</style>