---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Site Analysis';
const description = 'Audit technical SEO, speed, and accessibility to uncover issues and opportunities in one scan.';
const permalink = '/features/site-analysis';
const heroImage = '/assets/images/siteanalysis.webp';
---

<BaseLayout 
  title={`${title} — Marketifyall`}
  description={description}
  permalink={permalink}
  current="features"
  image={heroImage}
>
  <header class="feature-hero">
    <img src={heroImage} alt="Site Analysis illustration" class="hero-image" loading="eager" />
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <hr />
  </header>

  <section class="container content">
    <h2>Fix what matters</h2>
    <p>Get prioritized recommendations with clear steps so your team can resolve issues quickly.</p>

    <h2>Shareable reports</h2>
    <p>Send branded audits to clients or stakeholders with a single link and track improvements over time.</p>

    <h2>Comprehensive technical SEO audit</h2>
    <p>
      Deep dive into technical SEO issues with detailed analysis of crawlability, indexability, and
      performance. Identify and fix critical issues that impact search rankings and user experience.
    </p>

    <h2>Performance & Core Web Vitals</h2>
    <p>
      Monitor Core Web Vitals and performance metrics that affect both user experience and search rankings.
      Get actionable insights to improve page speed and overall site performance.
    </p>

    <h2>Accessibility & user experience</h2>
    <p>
      Ensure your site is accessible to all users with comprehensive accessibility audits. Improve user
      experience and meet compliance requirements with detailed recommendations.
    </p>

    <h2>Security & compliance monitoring</h2>
    <p>
      Monitor site security, SSL certificates, and compliance requirements. Get alerts for security issues
      and ensure your site meets industry standards and regulations.
    </p>
  </section>
</BaseLayout>

<style>
  .feature-hero { text-align: center; margin-top: 1rem; }
  .feature-hero h1 { margin: 0.5rem 0 0.25rem; }
  .feature-hero .lead { color: var(--text-secondary); font-family: var(--font-family-sans); font-weight: 500; max-width: 56ch; margin: 0 auto 0.75rem; }
  .feature-hero .hero-image { width: 100%; max-width: 560px; height: auto; display: block; margin: 1rem auto; border-radius: 10px; border: 1px solid var(--border-color); box-shadow: none; background: transparent; }

  /* Full-bleed banner variant */
  .feature-hero.banner .hero-image {
    max-width: none;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    border-radius: 0;
    border: none;
    height: 300px;
    object-fit: cover;
    object-position: center;
  }

  .feature-hero hr { min-width: 100px; width: 30%; }
  @media (max-width: 768px) { 
    .feature-hero .hero-image { max-width: 320px; } 
    .feature-hero.banner .hero-image {
      height: 200px;
      margin-left: calc(-50vw + 50%);
      margin-right: calc(-50vw + 50%);
    }
  }
</style>